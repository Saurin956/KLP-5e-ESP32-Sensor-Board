		(uuid "90fb5bb4-ba25-44e0-8001-ac9df7679733")
	)
	(text_box "USB-C allows for reversible \ncable insertion. Both pairs of \ndata pins (DP1/DN1 and \nDP2/DN2) are electrically \nidentical but physically flipped \ndepending on the cable \norientation."
		(exclude_from_sim no)
		(at 31.75 95.25 0)
		(size 33.02 15.24)
