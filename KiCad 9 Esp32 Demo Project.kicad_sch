	(text_box "The SBU1 and SBU2 pins on a USB-C connector are Sideband Use (SBU) pins. They \nare part of the USB-C standard and serve specialized roles depending on the \napplication, primarily in Alternate Modes (e.g.. DisplayPort, Thunderbolt) and certain \nUSB-C accessories.\nFor basic USB 2.0/3.0 operation (like in your ESP32-C3-02 design), the SBU pins \nare not used and can be left unconnected or handled with optional protective \nmeasures."
		(exclude_from_sim no)
		(at 66.04 92.71 0)
		(size 85.09 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3a9f328a-4913-4b4a-a8bf-691c720a9136")
	)
	(text_box "Low drop out (LDO) voltage regulator\n"
		(exclude_from_sim no)
		(at 30.48 115.57 0)
		(size 101.6 43.18)
